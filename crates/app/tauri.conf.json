{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mySSH",
  "version": "0.2.5",
  "identifier": "dev.myssh.app",
  "build": {
    "frontendDist": "../../app/ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../../app/ui run dev",
    "beforeBuildCommand": "npm --prefix ../../app/ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mySSH",
        "width": 1440,
        "height": 900,
        "dragDropEnabled": true,
        "windowEffects": { "effects": ["mica"], "state": "followsWindowActiveState" }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENDQ3RkFDMUVGMDAxMDAKUldRQUFmQWVySDlFWGRTVUxCcS9NaHR1UlQvdzZkOWZyZXZ5ZWNkYUlzcUppVStHbmpXSmFsaFcK",
      "endpoints": ["https://releases.myssh.dev/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "mySSH",
    "category": "Utility",
    "copyright": "mySSH contributors",
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "installMode": "perMachine" } }
  }
}
