{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mySSH",
  "version": "0.1.0",
  "identifier": "dev.myssh.app",
  "build": {
    "frontendDist": "../../app/ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../../app/ui run dev",
    "beforeBuildCommand": "npm --prefix ../../app/ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mySSH",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico"]
  }
}
